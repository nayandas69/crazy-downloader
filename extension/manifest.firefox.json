{
  "manifest_version": 3,
  "name": "YouTube Cookies Exporter",
  "version": "0.0.2",
  "description": "Export your signed-in YouTube cookies as a Netscape cookies.txt for Crazy Downloader.",
  "homepage_url": "https://github.com/nayandas69/crazy-downloader/tree/main/extension",
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-cookies@crazy-downloader.app",
      "strict_min_version": "115.0"
    }
  },
  "action": {
    "default_title": "Export YouTube cookies",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["cookies"],
  "host_permissions": ["https://*.youtube.com/*"]
}
